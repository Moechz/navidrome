# ============================================================
# Navidrome TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# Navidrome 上游版本（GitHub tag，不带 v 前缀）
NAVIDROME_VERSION=0.64.0

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 0.64.0-1
# 注：官方文档对版本号格式的描述已过时，现在不做硬性要求；
# 仍需保证 config.ini / DEBIAN/control / .lang 三处一致，每次提交递增，
# 且 Release tag 须等于该版本（如 v0.64.0-1）
# ⚠️ 迭代号永远不要零填充：dpkg 认为 -01 == -1
PKG_RELEASE=4

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64 - ARM64/aarch64 机型
TARGET_ARCH=${TARGET_ARCH:-amd64}

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
# 规范：小写字母/数字/连字符，字母开头，≤50 字符
# 注：与上游官方 deb 的包名同名（navidrome），用户从上游 deb 切换时
# dpkg 视为同包升级，天然规避文件互踩（无需也不可再声明 Conflicts 自身）
APP_ID=navidrome

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# config.ini.user 与 systemd User 必须一致）
APP_USER=navidrome

# 回环监听端口（官方推荐 8000-19999 段；4533 为上游默认端口的易记变体）
APP_PORT=8453

# deb 维护者信息（DEBIAN/control 的 Maintainer 与 config.ini 的 publisher）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
PUBLISHER="Moechz"
