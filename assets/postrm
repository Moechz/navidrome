#!/bin/bash
# postrm - 删除/清除后处理（官方模板 + 本应用清理项）
set -e

MAINT_LOG=/var/log/navidrome-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') postrm $*" >> "$MAINT_LOG" 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true

if [ "$1" = "purge" ]; then
  # 数据库、缓存与音乐库（含用户音乐文件——purge 即全部清除，remove 时保留）
  rm -rf /var/lib/navidrome
  # 系统层注册文件（postinst 兜底安装的）
  rm -f /etc/systemd/system/navidrome.service
  rm -f /etc/nginx/conf.d/navidrome.conf
  # 运行用户
  if id -u navidrome > /dev/null 2>&1; then
    userdel navidrome 2>/dev/null || true
  fi
  systemctl daemon-reload 2>/dev/null || true
  # nginx 路由移除后重载生效
  if command -v nginx > /dev/null 2>&1 && nginx -t > /dev/null 2>&1; then
    nginx -s reload > /dev/null 2>&1 || true
  fi
  # 注：/var/log/navidrome-maint.log 保留（purge 取证用）
  # 注：/usr/local/navidrome 由 dpkg 按包清单删除；但 postinst 解压的
  # index.html（webui 占位页解压物）不在清单里，此处补清以免目录残留
  rm -f /usr/local/navidrome/index.html
  rmdir --ignore-fail-on-non-empty /usr/local/navidrome 2>/dev/null || true
fi

exit 0
