# ===========================================================================
# Multilingual file for the TOS 7 Docker application "navidromedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Navidrome"
auth         = "Navidrome"
version      = "@@VERSION@@"
descript     = "Navidrome is a self-hosted music server. It indexes the music folder you mount into a library of artists, albums and tracks, then streams it to its web player or to any Subsonic-compatible app on your network. Build playlists, mark favourites, browse by genre, share albums and playlists by link, play internet radio and transcode what browsers cannot play. Users, passwords and the database stay in DockerAppData/navidromedocker. Artist bios and photos come from public metadata services you can switch off."
release_note = "0.64.2-3: rectified per the App Center rejection notice (C3 C4 C5 C6 C7 C8 C9 F22 S11 T1, plus C2 C10 F11 V7 from the x86_64 notice). C3 C4 C5: complete privacy policy in PRIVACY.md, and help now points at that public page. C6: the upstream insights telemetry is disabled (ND_ENABLEINSIGHTSCOLLECTOR=false) and the declaration now matches what the app really sends. C7: access, correction and deletion rights plus the contact channel are written down. C8: endpoint table for Deezer, Last.fm, ListenBrainz, navidrome.org and the disabled insights collector. C9: the description lists only delivered features and the Chinese texts were rewritten. F22: the package now ships webui.bz2, a front-end page that forwards to port 8157. S11: non-root uid 1000, umask 077, owner-only data directory, cap_drop ALL and no-new-privileges. T1: 0.64.2 is still the newest upstream release, so the image is pinned by digest and the CVE follow-up plan is in CHANGELOG.md. C2: GPL-3.0-or-later verified against upstream. C10: README documents layout, privacy, notices, build, data and uninstall. F11: the data folder and its removal are documented. V7: both packages rebuilt, hashes recorded and the platform file_hash checked after submission."
important    = "First start: open port 8157 and create the admin account. Put music in DockerAppData/navidromedocker/music or change the mount. The container runs as uid 1000, so that folder must be writable by it. Needs DockerEngine, set a registry mirror if Docker Hub is unreachable. Plain HTTP on the LAN, use a TLS reverse proxy before exposing it to the internet. A scan sends artist names to Deezer, Last.fm and ListenBrainz (see PRIVACY.md). Insights telemetry is disabled here."

[zh-cn]
name         = "Navidrome"
auth         = "Navidrome"
version      = "@@VERSION@@"
descript     = "Navidrome 是运行在 NAS 上的自建音乐服务器。它索引你挂载的音乐目录，建立歌手、专辑与曲目资料库，并把音乐串流给内置网页播放器或局域网内任何兼容 Subsonic 的客户端。你可以建立播放清单、标记喜爱与评分、按类型浏览、用链接分享专辑与播放清单、收听网络电台，并把浏览器无法播放的格式转码。用户、密码与音乐数据库都保存在 NAS 的 DockerAppData/navidromedocker 目录内。歌手简介与照片来自公开元数据服务，可以自行关闭。"
release_note = "0.64.2-3：按商店驳回通知整改（C3 C4 C5 C6 C7 C8 C9 F22 S11 T1，以及 x86_64 通知中的 C2 C10 F11 V7）。C3 C4 C5：新增完整隐私政策 PRIVACY.md，help 指向该公开页面。C6：关闭上游默认开启的 insights 遥测（ND_ENABLEINSIGHTSCOLLECTOR=false），声明与实际发送的数据一致。C7：写明访问、更正、删除的权利与联系渠道。C8：新增端点表，列明 Deezer、Last.fm、ListenBrainz、navidrome.org 以及已关闭的 insights 采集器。C9：描述只写真实交付的功能，中文文案重写。F22：包内新增 webui.bz2，跳转到 8157 端口。S11：非 root（uid 1000）、umask 077、数据目录仅属主可读、cap_drop ALL、no-new-privileges。T1：0.64.2 仍是上游最新版本，镜像按摘要固定，跟进计划见 CHANGELOG.md。C2：许可核实为 GPL-3.0-or-later。C10：README 补充仓库结构、隐私、声明、构建、数据与卸载。F11：写明数据目录与卸载删除方式。V7：双架构重新构建并核对平台 file_hash。"
important    = "首次使用请打开 8157 端口并建立管理员账号。把音乐放入 DockerAppData/navidromedocker/music，或修改挂载目录。容器以 uid 1000 运行，数据目录需要对该用户可写。需要 DockerEngine，Docker Hub 不可达时请先配置镜像加速。页面是局域网明文 HTTP，暴露到公网前请使用 TLS 反向代理。扫描音乐库时会把歌手名发送给 Deezer、Last.fm 与 ListenBrainz，详见 PRIVACY.md。本包已关闭上游的 insights 遥测。"

[zh-hk]
name         = "Navidrome"
auth         = "Navidrome"
version      = "@@VERSION@@"
descript     = "Navidrome 是運行在 NAS 上的自建音樂伺服器。它索引你掛載的音樂目錄，建立歌手、專輯與曲目資料庫，並把音樂串流給內建網頁播放器或區域網路內任何相容 Subsonic 的用戶端。你可以建立播放清單、標記喜愛與評分、按類型瀏覽、用連結分享專輯與播放清單、收聽網路電台，並把瀏覽器無法播放的格式轉碼。使用者、密碼與音樂資料庫都保存在 NAS 的 DockerAppData/navidromedocker 目錄內。歌手簡介與照片來自公開中繼資料服務，可以自行關閉。"
release_note = "0.64.2-3：按商店駁回通知整改（C3 C4 C5 C6 C7 C8 C9 F22 S11 T1，以及 x86_64 通知中的 C2 C10 F11 V7）。C3 C4 C5：新增完整隱私政策 PRIVACY.md，help 指向該公開頁面。C6：關閉上游預設開啟的 insights 遙測（ND_ENABLEINSIGHTSCOLLECTOR=false），宣告與實際傳送的資料一致。C7：寫明存取、更正、刪除的權利與聯絡管道。C8：新增端點表，列明 Deezer、Last.fm、ListenBrainz、navidrome.org 以及已關閉的 insights 收集器。C9：描述只寫真實交付的功能，中文文案重寫。F22：包內新增 webui.bz2，跳轉到 8157 連接埠。S11：非 root（uid 1000）、umask 077、資料目錄僅屬主可讀、cap_drop ALL、no-new-privileges。T1：0.64.2 仍是上游最新版本，映像按摘要固定，跟進計畫見 CHANGELOG.md。C2：授權核實為 GPL-3.0-or-later。C10：README 補充倉庫結構、隱私、聲明、建置、資料與解除安裝。F11：寫明資料目錄與解除安裝刪除方式。V7：雙架構重新建置並核對平台 file_hash。"
important    = "首次使用請開啟 8157 連接埠並建立管理員帳號。把音樂放入 DockerAppData/navidromedocker/music，或修改掛載目錄。容器以 uid 1000 執行，資料目錄需要對該使用者可寫。需要 DockerEngine，Docker Hub 不可達時請先設定鏡像加速。頁面是區域網路明文 HTTP，暴露到公網前請使用 TLS 反向代理。掃描音樂庫時會把歌手名傳送給 Deezer、Last.fm 與 ListenBrainz，詳見 PRIVACY.md。本包已關閉上游的 insights 遙測。"

